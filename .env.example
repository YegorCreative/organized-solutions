# Canonical public URL for metadata, sitemap, and Open Graph.
# GitHub Actions sets this from the Pages environment.
# Local default: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Subpath when GitHub Pages serves a project site
# (https://user.github.io/organized-solutions/).
# Empty for local development and for a custom-domain root.
NEXT_PUBLIC_BASE_PATH=

# Formspree form endpoint for browser POST (public in the client bundle).
# Create the form at https://formspree.io/ connected to
# admin@organizedsolutionsgroup.com, then set:
#   NEXT_PUBLIC_CONTACT_FORM_ENDPOINT=https://formspree.io/f/{form_id}
# Local: .env.local  |  Production: GitHub repo variable of the same name.
# Leave empty until the owner-created Formspree form exists.
# Do not put Formspree account passwords or API keys here.
NEXT_PUBLIC_CONTACT_FORM_ENDPOINT=
