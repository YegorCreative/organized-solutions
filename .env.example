# Canonical public URL for metadata, sitemap, and Open Graph.
# GitHub Actions sets this from the Pages environment.
# Local default: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Subpath when GitHub Pages serves a project site
# (https://user.github.io/organized-solutions/).
# Empty for local development and for a custom-domain root.
NEXT_PUBLIC_BASE_PATH=
